                polycoef="1.5707963 1 0 0 0"
                solref="0.004 1" solimp="0.99 0.9999 0.001 0.5 2"/>
    </equality>
    <tendon>
        <fixed name="acople_paletizador">
            <joint joint="link1" coef="1"/>
            <joint joint="link2" coef="1"/>
            <joint joint="act" coef="1"/>
        </fixed>
    </tendon>
    <!-- act = 1.5693, no 1.57: es el valor que satisface la igualdad de arriba
         EXACTO (q1+q2+qa = L0 + a0 = 1.5693), asi el arranque no tiene un
         empujon del solver en el primer paso. -->
    <keyframe>
        <key name="home" qpos="0 0 0 1.5693" qvel="0 0 0 0" ctrl="0 0 0" />
    </keyframe>

    <!-- Cielo y piso. Va ULTIMO a proposito: el escenario trae un
         <body name="scenery"> y el orden de los cuerpos decide la numeracion de
         los geoms, asi que puesto aca el piso queda con el ultimo id y no
         corre ninguno de los del brazo. El detalle esta explicado en
         ../scene.xml y lo afirma test_plant.py.

         El cielo es decorado; el PISO NO. Lleva contype/conaffinity para que el
         `ee_collider` apoye en vez de hundirse. El resto del brazo lo atraviesa
         igual que antes. Verificado que la corrida dorada no lo toca: sus 1848
         estados estimados dan ncon = 0. -->
    <include file="../scene.xml"/>
</mujoco>