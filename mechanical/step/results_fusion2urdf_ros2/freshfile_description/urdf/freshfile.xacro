<?xml version="1.0" ?>
<robot name="freshfile" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find freshfile_description)/urdf/materials.xacro" />
<xacro:include filename="$(find freshfile_description)/urdf/freshfile.trans" />
<xacro:include filename="$(find freshfile_description)/urdf/freshfile.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.00024462314778673805 0.0006690500618988771 0.02290157467175394" rpy="0 0 0"/>
    <mass value="1.0930923393163645"/>
    <inertia ixx="0.001701" iyy="0.001476" izz="0.002179" ixy="1.9e-05" iyz="9.8e-05" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find freshfile_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find freshfile_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="rot_1">
  <inertial>
    <origin xyz="4.211396519312438e-06 -0.0015200747208973361 0.01599668146886188" rpy="0 0 0"/>
    <mass value="0.6513790826917025"/>
    <inertia ixx="0.000843" iyy="0.00055" izz="0.000869" ixy="0.0" iyz="3.3e-05" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.0 -6e-06 -0.0735" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find freshfile_description)/meshes/rot_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.0 -6e-06 -0.0735" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find freshfile_description)/meshes/rot_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="link1_1">
  <inertial>
    <origin xyz="-0.005596236283676627 0.028587620016876498 -0.04577301618625011" rpy="0 0 0"/>
    <mass value="0.6543664159166849"/>
    <inertia ixx="0.002522" iyy="0.002612" izz="0.000793" ixy="-3e-06" iyz="6e-05" ixz="-9.2e-05"/>
  </inertial>
  <visual>
    <origin xyz="0.0 0.029994 -0.1145" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find freshfile_description)/meshes/link1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.0 0.029994 -0.1145" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find freshfile_description)/meshes/link1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="link2_1">
  <inertial>
    <origin xyz="0.0046381082232385094 0.02394294020369139 0.03194968674094999" rpy="0 0 0"/>
    <mass value="0.8817118285851836"/>
    <inertia ixx="0.002166" iyy="0.00232" izz="0.000632" ixy="6e-06" iyz="2.9e-05" ixz="-0.000213"/>
  </inertial>
  <visual>
    <origin xyz="0.0 0.024994 0.0155" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find freshfile_description)/meshes/link2_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.0 0.024994 0.0155" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find freshfile_description)/meshes/link2_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="act_1">
  <inertial>
    <origin xyz="0.001861966263336063 -0.016500497504847278 0.026730955988772356" rpy="0 0 0"/>
    <mass value="0.17671625983548697"/>
    <inertia ixx="6e-05" iyy="8.2e-05" izz="6.3e-05" ixy="0.0" iyz="0.0" ixz="2e-06"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.019006 -0.1145" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find freshfile_description)/meshes/act_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.019006 -0.1145" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find freshfile_description)/meshes/act_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="Revolute 1" type="continuous">
  <origin xyz="0.0 6e-06 0.0735" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="rot_1"/>
  <axis xyz="0.0 -0.0 1.0"/>
</joint>

<joint name="Revolute 2" type="continuous">
  <origin xyz="0.0 -0.03 0.041" rpy="0 0 0"/>
  <parent link="rot_1"/>
  <child link="link1_1"/>
  <axis xyz="0.0 1.0 -0.0"/>
</joint>

<joint name="Revolute 3" type="continuous">
  <origin xyz="0.0 0.005 -0.13" rpy="0 0 0"/>
  <parent link="link1_1"/>
  <child link="link2_1"/>
  <axis xyz="0.0 1.0 -0.0"/>
</joint>

<joint name="Revolute 4" type="continuous">
  <origin xyz="0.0 0.044 0.13" rpy="0 0 0"/>
  <parent link="link2_1"/>
  <child link="act_1"/>
  <axis xyz="-0.0 -1.0 -0.0"/>
</joint>

</robot>
